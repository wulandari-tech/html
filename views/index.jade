doctype html
html
  head
    title Request Template
    link(rel='stylesheet', href='/css/style.css')
  body(class="bg-gray-100 font-sans")
    .container(class="mx-auto px-4 py-8")
      h1(class="text-3xl font-bold mb-4 text-center") Request a Template

      form(action="/request", method="POST", class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4")
        .mb-4
          label(for="name", class="block text-gray-700 text-sm font-bold mb-2") Name:
          input(type="text", id="name", name="name", required='',class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")

        .mb-4
          label(for="email", class="block text-gray-700 text-sm font-bold mb-2") Email:
          input(type="email", id="email", name="email", required='',class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
          
        .mb-4
          label(for='message', class='block text-gray-700 text-sm font-bold mb-2') Message:
          textarea(id='message', name='message', rows='4', required='', class='shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline')

        .mb-4
          label(for="templateType", class="block text-gray-700 text-sm font-bold mb-2") Template Type:
          select(id="templateType", name="templateType", required='',class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
            option(value="website") Website
            option(value="landingPage") Landing Page

        button(type="submit", class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline") Submit Request