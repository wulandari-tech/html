doctype html
html
  head
    title Admin Dashboard
    style.
      body {
        font-family: sans-serif;
        background-color: #f0f0f0;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      th {
        background-color: #f5f5f5;
      }
      .hidden{
        display: none;
      }

      /* Tambahkan style lain yang dibutuhkan di sini */

    script.
      function reply(email, message, originalRequest) {
        const decodedMessage = decodeURIComponent(message);
        const decodedRequest = JSON.parse(decodeURIComponent(originalRequest));
        document.getElementById('recipientEmail').value = email;
        document.getElementById('replyMessage').innerText = decodedMessage;
        document.getElementById('originalMessage').value = originalRequest;
        document.getElementById('replyForm').classList.remove('hidden');
      }
  body
    .container
      h1 Admin Dashboard

      table
        thead
          tr
            th Name
            th Email
            th Message
            th Template Type
            th Action
        tbody
          each request in requests
            tr
              td= request.name
              td= request.email
              td= request.message
              td= request.templateType
              td
                button(onclick=`reply('${request.email}', '${encodeURIComponent(request.message)}', '${encodeURIComponent(JSON.stringify(request))}')`) Reply

      form(id='replyForm', method='post', action='/admin/reply', class='hidden')
        input(type='hidden', name='recipientEmail', id='recipientEmail')      
        textarea(name='replyMessage', id="replyMessage")      
        input(type='hidden', name='originalMessage', id='originalMessage')      
        button(type='submit') Kirim Balasan